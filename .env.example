# Copy to .env and set your OpenAI-compatible service. Never commit .env.
MAJI_AI_BASE_URL=
MAJI_AI_MODEL=
MAJI_AI_API_KEY=
# Optional: none | json_object | json_schema (provider must support it)
MAJI_AI_RESPONSE_FORMAT=none
MAJI_AI_TIMEOUT_MS=15000
# console --commentary also uses these fields; commentary is capped at 8 seconds.
# Fish Audio: live console enables audio automatically when both fields are set.
# --audio makes valid Fish configuration mandatory; registered emotion cues are retained.
FISH_API_KEY=
FISH_REFERENCE_ID=faccba1a8ac54016bcfc02761285e67f
FISH_TTS_MODEL=s2.1-pro-free
# Optional Soullink / OBS output (also enabled by console --avatar).
# Fish cloud TTS is shared through the SDK TtsClient adapter; no key is sent to the page.
MAJI_AVATAR_ENABLED=false
MAJI_AVATAR_MODEL=
MAJI_AVATAR_PROFILE=
MAJI_AVATAR_CORE=
MAJI_AVATAR_NAME=雀魂主播
# Blank optional motion overrides fall back to MAJI_AI_*; never put these in model profiles.
MAJI_LIVE2D_AI_BASE_URL=
MAJI_LIVE2D_AI_MODEL=
MAJI_LIVE2D_AI_API_KEY=
MAJI_LIVE2D_AI_RESPONSE_FORMAT=
MAJI_LIVE2D_AI_TIMEOUT_MS=12000
# Optional, only for a provider/model that supports this field. This deployment uses low.
MAJI_LIVE2D_AI_REASONING_EFFORT=
# Legacy system-voice diagnostic (spike speech) only.
MAJI_TTS_VOICE=Tingting

# Optional loopback Bilibili relay for console --follow. Keep real tokens in .env.
MAJI_BILI_RELAY_URL=
MAJI_BILI_RELAY_TOKEN=

# Optional direct Bilibili login, used only with console --bili-direct or bili-check.
# Private (0600) local file containing SESSDATA, bili_jct, DedeUserID and buvid3 cookies.
# Keep this file under ignored data/local; never paste credentials into chat or commit them.
MAJI_BILI_COOKIE_FILE=
