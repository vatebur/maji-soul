{
  "name": "maji-soul",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.ts",
    "doctor": "npm start -- doctor",
    "spike": "npm start -- spike",
    "spike:engine": "node scripts/spike-engine.ts",
    "spike:protocol": "node scripts/inspect-protocol.ts",
    "build:avatar": "node scripts/build-avatar.mjs",
    "engine:build": "cargo build --locked --release --manifest-path native/engine-runner/Cargo.toml",
    "engine:test": "cargo test --locked --release --manifest-path native/engine-runner/Cargo.toml && node --test scripts/test-runner.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts scripts/acceptance/*.test.mjs",
    "acceptance:offline": "node --test scripts/acceptance/*.test.mjs",
    "acceptance:archive": "node scripts/acceptance/archive.mjs",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "7.4.3",
    "@soullink-emotion/engine": "0.1.0-beta.1",
    "@soullink-emotion/live2d-pixi": "0.1.0-beta.1",
    "@soullink-emotion/planner-openai": "0.1.0-beta.1",
    "@soullink-emotion/runtime-core": "0.1.0-beta.1",
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js": "7.4.3",
    "protobufjs": "7.5.4"
  }
}
